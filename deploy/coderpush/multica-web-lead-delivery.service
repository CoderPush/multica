[Unit]
Description=Deliver queued CoderPush Web Lead Lark replies
After=docker.service network-online.target
[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/multica-web-lead-delivery.env
ExecStart=/usr/bin/python3 /usr/local/lib/multica-web-lead-delivery/web_lead_delivery.py --since ${ACTIVATED_AT}
TimeoutStartSec=90
StandardOutput=journal
StandardError=journal
