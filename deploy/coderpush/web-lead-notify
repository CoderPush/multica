#!/usr/bin/env python3
"""Queue a Web Lead update through Multica; never claims Lark delivery."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess

LEAD = '23ac88c6-c40c-4800-ace7-fb22ed69f7bb'
PROJECT = '1f065765-5630-4e67-9f16-adffaa6b3ce3'
WORKSPACE = '7aec4dc4-be92-4dab-9eb9-2ab405af1e7c'
p = argparse.ArgumentParser(description=__doc__)
p.add_argument('issue')
p.add_argument('--reply-to', required=True)
p.add_argument('--milestone', choices=['started','preview','blocked','recovered','shipped','decision'], required=True)
p.add_argument('--body-file', required=True)
a = p.parse_args()
if os.environ.get('MULTICA_AGENT_ID') != LEAD or os.environ.get('MULTICA_WORKSPACE_ID') != WORKSPACE:
    p.error('Only the CoderPush Web Lead task may queue updates.')
body = Path(a.body_file).read_text()
if not 1 <= len(body.strip()) <= 2400 or '<at' in body or '![' in body:
    p.error('Use 1-2400 characters of text/Markdown without mentions or images.')
if not re.fullmatch(r'om_[A-Za-z0-9_]{8,100}', a.reply_to):
    p.error('Invalid originating Lark message ID.')
issue = json.loads(subprocess.check_output(['multica','issue','get',a.issue,'--output','json']))
if issue['project_id'] != PROJECT or issue['workspace_id'] != WORKSPACE:
    p.error('Only CoderPush Web issues are supported.')
# Task-scoped API still authorizes this write. The sender separately verifies
# actual comment authorship, project, current status, age and Lark destination.
payload = {'reply_to':a.reply_to,'milestone':a.milestone,'body':body,'expected_status':issue['status']}
result = subprocess.run(['multica','issue','comment','add',issue['id'],'--content-stdin','--output','json'],
    input='<!-- web-lead-lark-update:v1 -->\n'+json.dumps(payload,ensure_ascii=False),text=True,capture_output=True)
if result.returncode:
    print('Queue failed. Reconcile the issue comment before retrying.')
    raise SystemExit(result.returncode)
comment = json.loads(result.stdout)
print(json.dumps({'state':'queued','request_id':comment.get('id'), 'issue':issue['identifier'],
                  'receipt_command':f"multica issue metadata get {issue['identifier']} --key lark_delivery --output json"}))
